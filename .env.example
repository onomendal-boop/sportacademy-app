# MySQL connection string untuk Prisma.
# Salin file ini menjadi .env, lalu ganti user, password, host, dan nama database.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/aaa_sport_academy"

# Secret untuk menandatangani cookie session login.
# Wajib diganti dengan nilai acak yang panjang, terutama di production.
# Buat nilai acak dengan perintah:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# Contoh MySQL lokal XAMPP/Laragon dengan user root tanpa password:
# DATABASE_URL="mysql://root:@localhost:3306/aaa_sport_academy"

# Contoh format untuk MySQL cloud/server production:
# DATABASE_URL="mysql://user:password@your-host:3306/aaa_sport_academy"
